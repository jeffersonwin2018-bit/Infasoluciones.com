{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/servicios.html", "destination": "/servicios", "permanent": true },
    { "source": "/nosotros.html", "destination": "/nosotros", "permanent": true },
    { "source": "/contacto.html", "destination": "/cotizar", "permanent": true },
    { "source": "/privacidad.html", "destination": "/privacidad", "permanent": true },
    { "source": "/proyectos/index.html", "destination": "/proyectos", "permanent": true },
    { "source": "/proyectos/exhibicion-comercial.html", "destination": "/servicios/modulos-de-exhibicion", "permanent": true },
    { "source": "/proyectos/fichas-visuales.html", "destination": "/proyectos", "permanent": true },
    { "source": "/proyectos/modulos-acondicionamiento.html", "destination": "/servicios/instalaciones-comerciales", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' https:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live https://www.youtube.com https://s.ytimg.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://vercel.live; connect-src 'self' https://vercel.live; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://wa.me" }
      ]
    },
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
