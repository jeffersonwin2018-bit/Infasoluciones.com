---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';
import SEO from '@/components/seo/SEO.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppFloat from '@/components/layout/WhatsAppFloat.astro';
import { organizationSchema, websiteSchema } from '@/lib/schema';
import { SITE } from '@/config/site';
import { DEFAULT_SETTINGS } from '@/data/settings';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schemas?: (object | null)[];
  preload?: string;
}
const { schemas = [], preload, ...seo } = Astro.props;
const settings = Astro.locals.settings ?? DEFAULT_SETTINGS;
const allSchemas = [organizationSchema(), websiteSchema(), ...schemas];
const accent = settings.design.accent;
---
<!doctype html>
<html lang="es-PE" style={`--c-weld:${accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0c10" />
    <meta name="author" content={SITE.brand} />
    <meta name="application-name" content="INFA" />
    {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/media/brand/logo-infa.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
    <SEO {...seo} schemas={allSchemas} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {settings.announcement.active && settings.announcement.text && (
      <div class="annc" role="note"><span>{settings.announcement.text}</span></div>
    )}
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <div class="cursor" aria-hidden="true"><span class="cursor__dot"></span><span class="cursor__ring"><em></em></span></div>
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>

<style>
  .annc { position: relative; z-index: 85; padding: 10px var(--gutter); background: var(--c-weld); color: #fff; text-align: center; font: 600 var(--t-sm)/1.3 var(--f-body); }
  .annc + :global(.hdr) { top: 0; }
  :global(html:has(.annc)) :global(.hdr:not(.is-scrolled)) { top: 40px; }
  .cursor { position: fixed; inset: 0; z-index: 999; pointer-events: none; display: none; mix-blend-mode: normal; }
  :global(.has-cursor) .cursor { display: block; }
  .cursor__dot, .cursor__ring { position: fixed; left: 0; top: 0; border-radius: 50%; translate: -50% -50%; }
  .cursor__dot { width: 6px; height: 6px; background: var(--c-weld); }
  .cursor__ring { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgb(255 255 255 / .5); transition: width .35s var(--ease-out), height .35s var(--ease-out), background .35s, border-color .35s; }
  .cursor__ring em { font: 600 11px/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; font-style: normal; color: #fff; opacity: 0; transition: opacity .25s; }
  :global(.cursor--link) .cursor__ring { width: 58px; height: 58px; border-color: var(--c-weld); }
  :global(.cursor--view) .cursor__ring { width: 92px; height: 92px; background: var(--c-weld); border-color: var(--c-weld); }
  :global(.cursor--view) .cursor__ring em { opacity: 1; }
</style>
