---
/**
 * Metadatos de cada página. Un title y una description ÚNICOS por URL.
 * Canonical siempre al host sin www.
 */
import { SITE } from '@/config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schemas?: (object | null)[];
}
const { title, description, image = SITE.ogImage, noindex = false, schemas = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/', SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ogImage = new URL(image, SITE.url).href;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{schemas.filter(Boolean).map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
