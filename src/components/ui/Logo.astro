---
/** Logo real de INFA (IN/FA con martillo y llave) en insignia blanca redondeada. */
interface Props { size?: number; mono?: boolean }
const { size = 44 } = Astro.props;
---
<img class="logo" src={size > 48 ? '/media/brand/logo-badge-192.png' : '/media/brand/logo-badge-96.png'} srcset="/media/brand/logo-badge-96.png 96w, /media/brand/logo-badge-192.png 192w" sizes={`${size}px`} width={size} height={size} alt="INFA" decoding="async" style={`width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.22)}px;box-shadow:0 4px 14px rgb(0 0 0 / .25)`} />
