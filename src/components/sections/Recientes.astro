---
/** "Lo último del taller": las fotos más recientes subidas desde /admin, con fecha. Hace que la web se vea viva. */
import type { Work } from '@/data/works';
import { WORK_CATEGORIES } from '@/data/works';
import { fecha, haceCuanto } from '@/lib/format';
interface Props { works: Work[] }
const { works } = Astro.props;
const now = Date.now();
---
{works.length > 0 && (
  <section class="section rec" aria-labelledby="rec-title">
    <div class="shell">
      <div class="sec-head">
        <div>
          <p class="tag tag--dot">En vivo · Últimas fotos</p>
          <h2 id="rec-title" data-split>Recién salido<br />del taller.</h2>
        </div>
        <a class="btn" href="/proyectos">Ver toda la galería</a>
      </div>
      <ul class="rec__grid" data-lb-group="recientes">
        {works.map((w, i) => (
          <li data-reveal style={`--d:${i * 0.07}s`}>
            <button type="button" class="rec__card" data-cursor="Ver" data-lb data-src={w.src} data-video={w.video} data-title={w.title} data-meta={`${w.location ? w.location + ' · ' : ''}${fecha(w.date)}`}>
              <span class="rec__img"><img src={w.thumb} alt={w.title} width={w.w} height={w.h} loading="lazy" decoding="async" /></span>
              <span class="rec__meta">
                <span class="rec__when"><i></i>{haceCuanto(w.createdAt, now)}</span>
                <strong>{w.title}</strong>
                <span class="muted">{WORK_CATEGORIES[w.category]?.label}{w.location && ` · ${w.location}`}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<script>
  import '@/scripts/lightbox';
</script>
<style>
  .rec__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 2rem); }
  .rec__grid li:nth-child(3n + 2) { transform: translateY(8%); }
  .rec__card { display: grid; gap: var(--s-4); width: 100%; padding: 0; border: 0; background: none; color: inherit; text-align: left; font: inherit; cursor: pointer; }
  .rec__img { display: block; overflow: hidden; border-radius: var(--radius-lg); aspect-ratio: 4 / 3; background: var(--c-charcoal-2); }
  .rec__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .rec__card:hover img { transform: scale(1.06); }
  .rec__meta { display: grid; gap: 4px; }
  .rec__meta strong { font-size: var(--t-md); }
  .rec__meta .muted { font-size: var(--t-sm); }
  .rec__when { display: inline-flex; align-items: center; gap: 8px; font: 500 var(--t-xs) var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--c-weld); }
  .rec__when i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 0 currentColor; animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px transparent; } }
  @media (max-width: 860px) { .rec__grid { grid-template-columns: 1fr 1fr; } .rec__grid li:nth-child(3n + 2) { transform: none; } }
  @media (max-width: 520px) { .rec__grid { grid-template-columns: 1fr; } }
</style>
