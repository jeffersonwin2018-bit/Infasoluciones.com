---
import { CONFIANZA, TESTIMONIOS, PROCESO } from '@/data/content';
import { SITE } from '@/config/site';
---
<section class="section conf" aria-labelledby="conf-title">
  <div class="shell">
    <p class="tag"><b>05</b> / Confianza</p>
    <h2 id="conf-title" data-reveal>Formal desde la cotización<br />hasta el acta de entrega.</h2>
    <ul class="conf__grid">
      {CONFIANZA.map((c) => (
        <li data-reveal><h3>{c.titulo}</h3><p>{c.texto}</p></li>
      ))}
    </ul>
    {SITE.ruc && <p class="conf__ruc tag">RUC {SITE.ruc} · {SITE.legalName}</p>}

    <ol class="proc" aria-label="Proceso de trabajo">
      {PROCESO.map((p) => (
        <li data-reveal><span class="tag"><b>{p.n}</b></span><strong>{p.t}</strong><p>{p.d}</p></li>
      ))}
    </ol>

    {TESTIMONIOS.length > 0 && (
      <div class="testi">
        {TESTIMONIOS.map((t) => (
          <figure data-reveal>
            <blockquote>“{t.texto}”</blockquote>
            <figcaption><strong>{t.nombre}</strong> · {t.cargo}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</section>
<style>
  .conf__grid { list-style: none; padding: 0; margin: var(--s-12) 0 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: var(--line); }
  .conf__grid li { padding: var(--s-8) var(--s-6) var(--s-8) 0; border-right: var(--line); }
  .conf__grid li:last-child { border-right: 0; }
  .conf__grid h3 { font-size: var(--t-md); }
  .conf__grid p { color: var(--c-steel-dim); font-size: var(--t-sm); }
  .proc { list-style: none; padding: 0; margin: var(--s-16) 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--s-6); counter-reset: p; }
  .proc li { display: grid; gap: var(--s-2); padding-top: var(--s-4); border-top: 2px solid var(--c-charcoal-3); }
  .proc li:first-child { border-color: var(--c-weld); }
  .proc p { color: var(--c-steel-dim); font-size: var(--t-sm); }
  .testi { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--s-6); margin-top: var(--s-16); }
  .testi blockquote { margin: 0 0 var(--s-4); font-size: var(--t-lg); line-height: 1.3; }
  @media (max-width: 960px) { .conf__grid { grid-template-columns: 1fr 1fr; } .proc { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .conf__grid, .proc { grid-template-columns: 1fr; } .conf__grid li { border-right: 0; border-bottom: var(--line); } }
</style>
