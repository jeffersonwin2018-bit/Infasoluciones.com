---
/**
 * Robert (asistente IA) + barra inferior para celular + estilos del mini reproductor.
 * - Escritorio: botón flotante y ventana de chat.
 * - Celular: barra inferior tipo app (Obras · Servicios · Robert · Música · WhatsApp) y chat a pantalla completa.
 */
import { waLink } from '@/lib/whatsapp';
import Icon from '@/components/ui/Icon.astro';
const avatar = '<img src="/media/brand/robert-192.webp" srcset="/media/brand/robert-96.webp 96w, /media/brand/robert-192.webp 192w, /media/brand/robert-384.webp 384w" sizes="64px" width="64" height="64" alt="" decoding="async">';
---
<button class="rb-launch" type="button" data-robert-open aria-label="Hablar con Robert, el asistente de INFA">
  <span class="rb-launch__av" set:html={avatar} />
  <span class="rb-launch__txt"><small>Asistente IA</small>Pregúntale a Robert</span>
</button>

<nav class="dock" aria-label="Accesos rápidos">
  <a href="/proyectos" class="dock__i"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg><span>Obras</span></a>
  <a href="/servicios" class="dock__i"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.2L3 17.8V21h3.2l6.3-6.3a4 4 0 0 0 5.2-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/></svg><span>Servicios</span></a>
  <button type="button" class="dock__robert" data-robert-open aria-label="Hablar con Robert">
    <span set:html={avatar} /><em>Robert</em>
  </button>
  <button type="button" class="dock__i" data-sound aria-pressed="false" aria-label="Activar música"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg><span>Música</span></button>
  <a href={waLink('Hola INFA 👋, vi su página web y quisiera cotizar un proyecto.')} target="_blank" rel="noopener" class="dock__i dock__wa"><Icon name="whatsapp" size={22} /><span>WhatsApp</span></a>
</nav>

<div class="rb" data-robert hidden>
  <div class="rb__scrim" data-robert-close></div>
  <section class="rb__box" role="dialog" aria-modal="true" aria-labelledby="rb-title">
    <header class="rb__head">
      <span class="rb__av" set:html={avatar} />
      <div><strong id="rb-title">Robert</strong><small><i></i> Asistente IA de INFA</small></div>
      <button type="button" class="rb__x" data-robert-clear title="Nueva conversación" aria-label="Nueva conversación">↺</button>
      <button type="button" class="rb__x" data-robert-close aria-label="Cerrar">✕</button>
    </header>
    <div class="rb__log" data-robert-log aria-live="polite"></div>
    <div class="rb__chips" data-robert-chips>
      <button type="button">¿Qué hacen en INFA?</button>
      <button type="button">Muéstrame sus obras</button>
      <button type="button">Quiero cotizar un mueble</button>
      <button type="button">Pon música chill elegante</button>
      <button type="button">¿Trabajan en Arequipa?</button>
    </div>
    <form class="rb__form" data-robert-form>
      <textarea name="q" rows="1" maxlength="1000" placeholder="Escríbele a Robert…" aria-label="Mensaje para Robert" enterkeyhint="send"></textarea>
      <button type="submit" aria-label="Enviar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12 20 4l-6 16-3-7z"/></svg></button>
    </form>
    <p class="rb__legal">Robert es una IA y puede equivocarse. Para cotizaciones, confirma por WhatsApp.</p>
  </section>
</div>

<div class="mtip" data-mtip hidden role="status">
  <span>🎵 ¿Otra música? <b>Pídesela a Robert</b>: cualquier canción, artista o estilo.</span>
  <button type="button" data-robert-open data-prefill="Pon ">Pedir canción</button>
  <button type="button" class="mtip__x" aria-label="Cerrar">✕</button>
</div>

<script>
  import '@/scripts/robert';
</script>

<style is:global>
  /* ── Lanzador (escritorio) ── */
  .rb-launch { position: fixed; left: max(18px, env(safe-area-inset-left)); bottom: max(18px, env(safe-area-inset-bottom)); z-index: 89; display: flex; align-items: center; gap: 10px; padding: 6px 18px 6px 6px; border: 1px solid rgb(255 255 255 / .16); border-radius: 99px; background: rgb(19 41 75 / .92); backdrop-filter: blur(12px); color: #fff; cursor: pointer; box-shadow: 0 16px 40px -10px rgb(0 0 0 / .6); transition: transform .4s var(--ease-out); }
  .rb-launch:hover { transform: translateY(-3px); }
  .rb-launch.is-compact { padding: 6px; }
  .rb-launch.is-compact .rb-launch__txt { display: none; }
  .rb-launch.is-compact:hover .rb-launch__txt { display: grid; }
  .rb-launch.is-compact:hover { padding-right: 18px; }
  .rb-launch__av img, .rb__av img, .dock__robert img { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  .rb-launch__av { width: 44px; height: 44px; }
  .rb-launch__txt { display: grid; text-align: left; font: 750 .95rem/1.1 var(--f-display); }
  .rb-launch__txt small { font: 500 .62rem/1.2 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: #9fb4d9; }

  /* ── Chat ── */
  .rb { position: fixed; inset: 0; z-index: 320; }
  .rb[hidden] { display: none; }
  .rb__scrim { position: absolute; inset: 0; background: rgb(5 6 10 / .5); backdrop-filter: blur(3px); animation: rbFade .3s both; }
  .rb__box { position: absolute; left: max(18px, env(safe-area-inset-left)); bottom: max(18px, env(safe-area-inset-bottom)); width: min(420px, calc(100vw - 36px)); height: min(680px, calc(100dvh - 36px)); display: flex; flex-direction: column; border-radius: 24px; overflow: hidden; background: #f4f5f8; color: #14161c; box-shadow: 0 40px 100px rgb(0 0 0 / .55); animation: rbIn .45s var(--ease-out) both; }
  @keyframes rbIn { from { opacity: 0; transform: translateY(24px) scale(.97); } }
  @keyframes rbFade { from { opacity: 0; } }
  .rb__head { display: flex; align-items: center; gap: 10px; padding: 14px 14px 14px 16px; background: #13294b; color: #fff; }
  .rb__av { width: 40px; height: 40px; flex: none; }
  .rb__head > div { flex: 1; line-height: 1.15; }
  .rb__head strong { font: 800 1.05rem var(--f-display); }
  .rb__head small { display: flex; align-items: center; gap: 6px; font-size: .75rem; color: #b9c6dd; }
  .rb__head small i { width: 7px; height: 7px; border-radius: 50%; background: #3ddc84; }
  .rb__x { width: 38px; height: 38px; border: 0; border-radius: 50%; background: rgb(255 255 255 / .1); color: #fff; font-size: 1rem; cursor: pointer; }
  .rb__log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; overscroll-behavior: contain; }
  .rb__msg { max-width: 86%; padding: 11px 14px; border-radius: 18px; font-size: .95rem; line-height: 1.45; word-wrap: break-word; }
  .rb__msg p { margin: 0 0 6px; } .rb__msg p:last-child { margin: 0; }
  .rb__msg ul { margin: 4px 0; padding-left: 18px; }
  .rb__msg a { color: inherit; }
  .rb__msg--bot { align-self: flex-start; background: #fff; border-bottom-left-radius: 6px; box-shadow: 0 1px 2px rgb(0 0 0 / .06); }
  .rb__msg--me { align-self: flex-end; background: #13294b; color: #fff; border-bottom-right-radius: 6px; }
  .rb__msg--status { align-self: flex-start; background: none; color: #646b78; font-size: .82rem; padding: 2px 4px; }
  .rb__typing { display: inline-flex; gap: 4px; }
  .rb__typing i { width: 7px; height: 7px; border-radius: 50%; background: #9aa2b1; animation: rbDot 1s infinite; }
  .rb__typing i:nth-child(2) { animation-delay: .15s; } .rb__typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes rbDot { 50% { transform: translateY(-4px); opacity: .5; } }
  .rb__act { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 12px; border: 0; background: #25d366; color: #05290f; font-weight: 700; text-decoration: none; cursor: pointer; font-size: .9rem; }
  .rb__chips { display: flex; gap: 8px; overflow-x: auto; padding: 0 16px 10px; scrollbar-width: none; }
  .rb__chips[hidden] { display: none; }
  .rb__chips button { flex: none; padding: 9px 13px; border: 1px solid #d9dde5; border-radius: 99px; background: #fff; font: 600 .82rem var(--f-body); color: #13294b; cursor: pointer; }
  .rb__form { display: flex; align-items: flex-end; gap: 8px; padding: 10px 12px; background: #fff; border-top: 1px solid #e3e6ec; }
  .rb__form textarea { flex: 1; min-height: 46px; max-height: 120px; padding: 12px 14px; border: 1.5px solid #e1e4ea; border-radius: 16px; resize: none; font: 400 16px/1.35 var(--f-body); color: #14161c; outline: none; background: #f7f8fa; }
  .rb__form textarea:focus { border-color: #13294b; background: #fff; }
  .rb__form button { width: 46px; height: 46px; flex: none; border: 0; border-radius: 50%; background: var(--c-weld); color: #fff; cursor: pointer; display: grid; place-items: center; }
  .rb__form button svg { width: 20px; height: 20px; fill: currentColor; }
  .rb__form button:disabled { opacity: .5; }
  .rb__legal { margin: 0; padding: 0 14px 10px; background: #fff; font-size: .68rem; color: #8a909b; text-align: center; max-width: none; }

  /* ── Mini reproductor ── */
  .np { position: fixed; left: max(18px, env(safe-area-inset-left)); bottom: calc(max(18px, env(safe-area-inset-bottom)) + 70px); z-index: 88; display: grid; grid-template-columns: 44px minmax(0, 1fr) repeat(4, 34px); align-items: center; gap: 6px; width: min(380px, calc(100vw - 28px)); padding: 8px; border-radius: 18px; background: rgb(14 16 22 / .9); backdrop-filter: blur(16px); border: 1px solid rgb(255 255 255 / .12); color: #fff; box-shadow: 0 20px 50px rgb(0 0 0 / .5); }
  .np[hidden] { display: none; }
  .np .yt-host { display: none; grid-column: 1 / -1; border-radius: 12px; overflow: hidden; aspect-ratio: 16 / 9; background: #000; }
  .np.is-yt .yt-host { display: block; }
  .np .yt-host iframe { width: 100%; height: 100%; display: block; }
  .np__art { position: relative; width: 44px; height: 44px; border-radius: 10px; overflow: hidden; background: var(--c-weld); display: grid; place-items: center; }
  .np__art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .np.is-yt .np__art { display: none; }
  .np.is-yt { grid-template-columns: minmax(0, 1fr) repeat(4, 34px); width: min(300px, calc(100vw - 28px)); }
  .np__eq { display: flex; align-items: end; gap: 2px; height: 16px; position: relative; }
  .np__eq b { width: 3px; height: 4px; background: #fff; border-radius: 2px; }
  .np.is-playing .np__eq b { animation: eq 1s ease-in-out infinite; }
  .np__eq b:nth-child(2) { animation-delay: -.3s !important; } .np__eq b:nth-child(3) { animation-delay: -.6s !important; }
  .np__txt { display: grid; min-width: 0; line-height: 1.2; }
  .np__txt strong, .np__txt small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .np__txt strong { font-size: .85rem; } .np__txt small { font-size: .72rem; color: #a7afbd; }
  .np__b { width: 34px; height: 34px; border: 0; border-radius: 50%; background: rgb(255 255 255 / .08); color: #fff; font-size: .8rem; cursor: pointer; }
  .np__b:hover { background: var(--c-weld); }

  /* ── Sugerencia de música ── */
  .mtip { position: fixed; left: 50%; bottom: calc(max(18px, env(safe-area-inset-bottom)) + 90px); z-index: 87; translate: -50% 0; display: flex; align-items: center; gap: 10px; width: min(560px, calc(100vw - 24px)); padding: 10px 10px 10px 16px; border-radius: 16px; background: #fff; color: #14161c; font-size: .9rem; box-shadow: 0 20px 50px rgb(0 0 0 / .45); animation: rbIn .5s var(--ease-out) both; }
  .mtip[hidden] { display: none; }
  .has-np .mtip { bottom: calc(max(18px, env(safe-area-inset-bottom)) + 160px); }
  .mtip span { flex: 1; }
  .mtip button { flex: none; border: 0; border-radius: 10px; padding: 9px 12px; background: #13294b; color: #fff; font-weight: 700; cursor: pointer; }
  .mtip .mtip__x { background: none; color: #777; padding: 6px; }

  /* ── Barra inferior (celular) ── */
  .dock { display: none; }
  @media (max-width: 860px) {
    .rb-launch, .waf { display: none !important; }
    .dock { position: fixed; left: 10px; right: 10px; bottom: max(10px, env(safe-area-inset-bottom)); z-index: 90; display: grid; grid-template-columns: repeat(5, 1fr); align-items: end; padding: 6px; border-radius: 22px; background: rgb(14 16 22 / .88); backdrop-filter: blur(18px) saturate(1.4); border: 1px solid rgb(255 255 255 / .1); box-shadow: 0 18px 40px rgb(0 0 0 / .5); }
    .dock__i { display: grid; justify-items: center; gap: 3px; padding: 8px 0 6px; border: 0; background: none; color: #c4cad5; text-decoration: none; font: 600 .66rem/1 var(--f-body); cursor: pointer; border-radius: 14px; }
    .dock__i svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .dock__wa { color: #25d366; }
    .dock__wa svg { stroke: none; fill: currentColor; }
    .dock__i[aria-pressed='true'] { color: #fff; background: rgb(255 255 255 / .08); }
    .dock__i[aria-pressed='true'] svg { stroke: var(--c-weld); }
    .dock__robert { display: grid; justify-items: center; gap: 3px; margin-top: -26px; border: 0; background: none; color: #fff; cursor: pointer; font: 700 .66rem/1 var(--f-body); }
    .dock__robert span { width: 60px; height: 60px; border-radius: 50%; padding: 2px; background: linear-gradient(140deg, var(--c-weld), #13294b); box-shadow: 0 10px 26px rgb(232 41 58 / .45); }
    .dock__robert em { font-style: normal; }
    body { padding-bottom: calc(86px + env(safe-area-inset-bottom)); }
    .np { bottom: calc(max(10px, env(safe-area-inset-bottom)) + 84px); left: 10px; width: calc(100vw - 20px); }
    .mtip { bottom: calc(max(10px, env(safe-area-inset-bottom)) + 96px); font-size: .84rem; }
    .has-np .mtip { bottom: calc(max(10px, env(safe-area-inset-bottom)) + 160px); }
    .rb__box { inset: 0; width: 100%; height: 100dvh; border-radius: 0; padding-bottom: env(safe-area-inset-bottom); }
    .rb__head { padding-top: max(14px, env(safe-area-inset-top)); }
    .rb__scrim { display: none; }
  }
</style>
