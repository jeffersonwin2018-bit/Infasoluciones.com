---
/**
 * Botón de WhatsApp flotante — llamativo pero no invasivo:
 * pastilla verde con texto, anillos de pulso, insignia "1" y una burbuja de chat
 * que aparece a los 6 s (una vez por sesión) con un mensaje directo.
 */
import { waLink } from '@/lib/whatsapp';
import Icon from '@/components/ui/Icon.astro';
import { SITE } from '@/config/site';
---
<div class="waf" data-waf>
  <div class="waf__bubble" role="status" aria-live="polite">
    <button class="waf__x" type="button" aria-label="Cerrar mensaje">×</button>
    <div class="waf__who">
      <span class="waf__av">IN<b>FA</b></span>
      <span><strong>INFA</strong><small><i></i> En línea · responde rápido</small></span>
    </div>
    <p>👋 ¡Hola! ¿Tienes un proyecto? Mándanos una foto o las medidas y te cotizamos.</p>
    <a class="waf__go" href={waLink('Hola INFA 👋, vi su página web y quisiera cotizar un proyecto.')} target="_blank" rel="noopener">Responder en WhatsApp →</a>
  </div>
  <a class="waf__btn" href={waLink('Hola INFA 👋, vi su página web y quisiera cotizar un proyecto.')} target="_blank" rel="noopener" aria-label={`Escribir a INFA por WhatsApp (${SITE.phoneDisplay})`}>
    <span class="waf__ring" aria-hidden="true"></span><span class="waf__ring waf__ring--2" aria-hidden="true"></span>
    <span class="waf__ico"><Icon name="whatsapp" size={30} /><em class="waf__badge">1</em></span>
    <span class="waf__txt"><small>¿Cotizamos?</small>Escríbenos</span>
  </a>
</div>

<script>
  const w = document.querySelector<HTMLElement>('[data-waf]');
  const KEY = 'infa-wa-bubble';
  let seen = false;
  try { seen = sessionStorage.getItem(KEY) === '1'; } catch {}
  const show = () => { if (!seen) w?.classList.add('is-bubble'); };
  const hide = () => { w?.classList.remove('is-bubble'); try { sessionStorage.setItem(KEY, '1'); } catch {} seen = true; };
  setTimeout(show, 6000);
  w?.querySelector('.waf__x')?.addEventListener('click', hide);
  w?.querySelectorAll('a').forEach((a) => a.addEventListener('click', hide));
  // Oculto mientras se ve el hero en móvil para no tapar el título; aparece al hacer scroll
  addEventListener('scroll', () => w?.classList.toggle('is-on', scrollY > 120), { passive: true });
  if (scrollY > 120) w?.classList.add('is-on');
</script>

<style>
  .waf { position: fixed; right: max(18px, env(safe-area-inset-right)); bottom: max(18px, env(safe-area-inset-bottom)); z-index: 90; display: grid; justify-items: end; gap: 12px; transform: translateY(140%); transition: transform .8s var(--ease-out); }
  .waf.is-on { transform: none; }
  .waf__btn { position: relative; display: flex; align-items: center; gap: 12px; padding: 8px 22px 8px 8px; border-radius: 999px; background: var(--c-wa); color: #05290f; text-decoration: none;
    box-shadow: 0 18px 40px -10px rgb(37 211 102 / .65), 0 4px 14px rgb(0 0 0 / .35); transition: transform .4s var(--ease-out), box-shadow .4s; }
  .waf__btn:hover { transform: translateY(-4px) scale(1.03); box-shadow: 0 24px 50px -10px rgb(37 211 102 / .8), 0 4px 14px rgb(0 0 0 / .35); }
  .waf__ico { position: relative; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: #fff; color: #1ebe57; animation: wiggle 5s ease-in-out 3s infinite; }
  .waf__badge { position: absolute; top: -4px; right: -4px; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: #ff3b30; color: #fff; font: 700 11px/1 var(--f-body); font-style: normal; border: 2px solid var(--c-wa); }
  .waf__txt { display: grid; font: 800 1.05rem/1.05 var(--f-display); font-variation-settings: 'wdth' 105; }
  .waf__txt small { font: 600 .68rem/1.2 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; opacity: .75; }
  .waf__ring { position: absolute; inset: 0; border-radius: inherit; border: 2px solid var(--c-wa); animation: ring 2.4s var(--ease-out) infinite; pointer-events: none; }
  .waf__ring--2 { animation-delay: 1.2s; }
  @keyframes ring { 0% { transform: scale(1); opacity: .8; } 100% { transform: scale(1.35, 1.7); opacity: 0; } }
  @keyframes wiggle { 0%, 88%, 100% { transform: rotate(0); } 90% { transform: rotate(-14deg); } 93% { transform: rotate(12deg); } 96% { transform: rotate(-8deg); } }

  .waf__bubble { position: relative; width: min(320px, calc(100vw - 36px)); padding: 16px; border-radius: 18px 18px 4px 18px; background: #fff; color: #111; box-shadow: 0 24px 60px rgb(0 0 0 / .45);
    opacity: 0; transform: translateY(14px) scale(.96); transform-origin: bottom right; pointer-events: none; transition: opacity .5s var(--ease-out), transform .5s var(--ease-out); }
  .waf.is-bubble .waf__bubble { opacity: 1; transform: none; pointer-events: auto; }
  .waf__bubble p { margin: 10px 0 12px; font-size: .95rem; line-height: 1.45; }
  .waf__who { display: flex; align-items: center; gap: 10px; }
  .waf__who strong { display: block; font-size: .95rem; }
  .waf__who small { display: flex; align-items: center; gap: 6px; color: #3a7d4f; font-size: .75rem; }
  .waf__who small i { width: 7px; height: 7px; border-radius: 50%; background: #25d366; }
  .waf__av { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #13294b; color: #fff; font: 900 .7rem/1 var(--f-display); }
  .waf__av b { color: #ff5b66; }
  .waf__go { display: block; text-align: center; padding: 12px; border-radius: 12px; background: var(--c-wa); color: #05290f; font-weight: 700; text-decoration: none; }
  .waf__x { position: absolute; top: 6px; right: 8px; width: 28px; height: 28px; border: 0; background: none; font-size: 22px; line-height: 1; color: #777; cursor: pointer; }

  @media (max-width: 560px) {
    .waf__btn { padding: 6px; }
    .waf__txt { display: none; }
    .waf__ico { width: 58px; height: 58px; }
  }
</style>
